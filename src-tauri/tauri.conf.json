{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Book Craft",
  "version": "0.1.1",
  "identifier": "uz.nurafshon.bookcraft",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run prepare:resources && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Book Craft",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "publisher": "Otabek Sadiridinov",
    "copyright": "Copyright © 2026 Otabek Sadiridinov",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Write a book in Markdown, get a Windows app",
    "longDescription": "Book Craft turns a book written in Markdown into a Windows reader app: a portable .exe, a setup .exe, an .msi or an .msix.",
    "resources": {
      "resources/reader/": "resources/reader/",
      "resources/runtime/": "resources/runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
